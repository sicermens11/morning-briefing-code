data/naver-quarter/
data/dart-exec/
data/consensus/
data/us-symbols/
data/dart-major/
data/dart-fin/
data/contract/
data/fred/
data/etf-daily/

# ── 캐시 — 돌리면 다시 생긴다 (1.3GB · 100MB 한도도 넘는다) ───
data/_cache/
*.pkl

# ── 훑어본 자취 (221MB) ───────────────────────────────────────
data/_search/

# ── 만들어지는 화면 — 코드에서 다시 나온다 ────────────────────
data/briefing-site.html
data/briefing-cards.html
data/_preview-site.html
data/_qt확인.html

# ── 파이썬 ────────────────────────────────────────────────────
__pycache__/
*.pyc

# ══════════════════════════════════════════════════════════════
#  **넣는 것** (빼지 마라)
#    data/_labs/          시험 결과 342개 — 3주치. 못 되살린다
#    data/card-copy/      날마다 쓴 서술
#    data/forward-log.jsonl  앞으로 기록 — 채점의 근거
#    data/*.json          설정·규칙·성적표
#    scripts/ docs/ *.md  코드와 기록
#    run-logs/            실행 자취
# ══════════════════════════════════════════════════════════════
data/minute/
data/orderbook-antc/
data/forward-log.jsonl.bak
