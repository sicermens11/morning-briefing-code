     "entry_conditions": [{"type": "sma20", "value": 26235, "op": ">="},
                          {"type": "support", "value": 22550, "op": ">="}],
     "signals": ["강화-F2", "강화-TA"], "signal_points": {"강화-F2": 0, "강화-TA": 0},
     "grade_adjust": null, "note": "핵심 근거 한 줄",
     "발굴슬롯": "국내독립", "재료출처": "국내기사", "stop_loss": 22550}
